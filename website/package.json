{
  "name": "jg-plans-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --dir .. build && astro dev --host 127.0.0.1",
    "build": "node scripts/build.ts",
    "preview": "astro preview --host 127.0.0.1",
    "assets:generate": "node assets/render.ts",
    "assets:check": "node assets/render.ts --check",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "typecheck": "astro check",
    "test": "pnpm test:unit --mode essential --tagsFilter=!full && pnpm test:integration --mode essential --tagsFilter=!full",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm assets:check && pnpm build && pnpm typecheck && pnpm test && node scripts/verify-build.ts",
    "test:full": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "check:full": "pnpm assets:check && pnpm build && pnpm typecheck && pnpm test:full && node scripts/verify-build.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "jg-plans": "workspace:*",
    "jg-personal-astro-ui": "0.5.0",
    "jg-site": "0.1.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "jg-fs": "1.6.0",
    "jg-crypto": "0.3.0",
    "jg-exception": "1.7.0",
    "jg-fetch": "0.5.0",
    "jg-playwright": "0.1.0",
    "jg-process": "1.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
