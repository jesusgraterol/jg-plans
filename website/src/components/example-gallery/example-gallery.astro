---
import Tabs from 'jg-personal-astro-ui/tabs';

import { EXAMPLES } from '../../content/sources.ts';
import ExamplePanel from '../example-panel/example-panel.astro';
---

<div data-example-gallery>
  <noscript>
    <p class="mb-5 text-sm text-muted">
      All examples are shown below. Each source can be selected or downloaded.
    </p>
    <style is:inline>
      [data-example-gallery] [role='tablist'] {
        display: none;
      }
      @layer base {
        /* Override preflight's important hidden rule within its own layer. */
        [data-example-gallery] [data-tab-panel][hidden] {
          display: block !important;
        }
      }
    </style>
  </noscript>
  <Tabs id="examples" label="Planning examples" tabs={EXAMPLES}>
    <ExamplePanel slot="small" id="small" />
    <ExamplePanel slot="milestones" id="milestones" />
    <ExamplePanel slot="extensions" id="extensions" />
    <ExamplePanel slot="incomplete" id="incomplete" />
    <ExamplePanel slot="orphan" id="orphan" />
  </Tabs>
</div>
