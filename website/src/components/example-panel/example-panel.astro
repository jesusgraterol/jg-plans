---
import CodeBlock from 'jg-personal-astro-ui/code-block';
import Tabs from 'jg-personal-astro-ui/tabs';
import { loadExample } from '../../content/examples.ts';
import { EXAMPLES } from '../../content/sources.ts';
import DocumentFlow from '../document-flow/document-flow.astro';
interface Props {
  id: (typeof EXAMPLES)[number]['id'];
}
const example = await loadExample(Astro.props.id);
const tabs = [
  ...(example.plan ? [{ id: 'plan', label: 'plan.md' }] : []),
  ...(example.milestones ? [{ id: 'milestones', label: 'milestones.md' }] : []),
];
---

<section class="py-7 sm:py-9" aria-labelledby={`example-${example.id}`}>
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 id={`example-${example.id}`} class="text-2xl font-semibold tracking-tight sm:text-3xl">
        {example.label}
      </h2>
      <p class="mt-3 max-w-2xl text-muted">{example.description}</p>
    </div>
    <span class="rounded-full border border-border px-3 py-1.5 font-mono text-xs text-muted">
      {example.check.conforms ? 'Conforming example' : 'Tolerant reading'}
    </span>
  </header>
  <Tabs id={`source-${example.id}`} label={`${example.label} documents`} tabs={tabs}>
    {example.plan && (
      <div slot="plan" class="pt-5">
        <DocumentFlow
          source={example.documents.plan!}
          filename="plan.md"
          call="parsePlan(source)"
          result={{
            metadata: example.plan.metadata,
            rawMetadata: example.plan.rawMetadata,
            body: example.plan.body,
            diagnostics: example.plan.diagnostics,
          }}
        />
      </div>
    )}
    {example.milestones && (
      <div slot="milestones" class="pt-5">
        <DocumentFlow
          source={example.documents.milestones!}
          filename="milestones.md"
          call="parseMilestones(source)"
          result={{
            milestones: example.milestones.milestones.map(({ ordinal, title, status, id }) => ({
              ordinal,
              title,
              status,
              id,
            })),
            diagnostics: example.milestones.diagnostics,
          }}
        />
      </div>
    )}
  </Tabs>
  <aside class="mt-6" aria-label={`${example.label} observations`}>
    <dl class="grid grid-cols-2 gap-5 border-y border-border py-5 text-sm sm:grid-cols-4">
      <div>
        <dt class="text-muted">Plan document</dt>
        <dd class="mt-2 font-semibold">{example.plan ? 'Readable' : 'Missing'}</dd>
      </div>
      <div>
        <dt class="text-muted">Status</dt>
        <dd class="mt-2 font-mono text-xs wrap-anywhere">
          {example.plan?.metadata.status ?? 'Not recorded'}
        </dd>
      </div>
      <div>
        <dt class="text-muted">Revision</dt>
        <dd class="mt-2 font-mono">{example.plan?.metadata.revision ?? 'Not recorded'}</dd>
      </div>
      <div>
        <dt class="text-muted">Milestones</dt>
        <dd class="mt-2 font-mono">{example.milestones?.milestones.length ?? 'Not included'}</dd>
      </div>
    </dl>
    {example.plan === null && (
      <p class="mt-5 border-l-2 border-accent pl-4 text-sm text-muted">
        plan.md is deliberately absent. No file is restored.
      </p>
    )}
    {example.milestones && (
      <ol class="mt-5 grid gap-3 sm:grid-cols-2" aria-label="Observed milestone progress">
        {example.milestones.milestones.map((milestone) => (
          <li class="flex items-start gap-3 rounded-lg bg-secondary/50 p-4">
            <span class="mt-0.5 font-mono text-accent" aria-hidden="true">
              {milestone.status === 'done' ? '✓' : '○'}
            </span>
            <div>
              <p class="font-semibold">
                {milestone.ordinalText}. {milestone.title}
              </p>
              <p class="mt-1 font-mono text-xs text-muted">
                Status: {milestone.status ?? 'Not recorded'}
              </p>
            </div>
          </li>
        ))}
      </ol>
    )}
    <div class="mt-5">
      <p class="text-sm font-semibold">
        {example.check.conforms ? 'Preferred writer format' : 'Useful observations, with findings'}
      </p>
      <p class="mt-2 text-sm text-muted">
        A check describes the document. Your project decides what happens next.
      </p>
      {example.check.diagnostics.length > 0 && (
        <ul class="mt-4 grid gap-3 text-sm">
          {example.check.diagnostics.map((diagnostic) => (
            <li class="border-l-2 border-border-strong pl-4">
              <span class="font-mono text-xs wrap-anywhere">{diagnostic.code}</span>
              <p class="mt-1 text-muted">{diagnostic.message}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
    {example.plan?.rawMetadata && (
      <details class="mt-5 rounded-lg border border-border px-4 py-2">
        <summary class="min-h-9 cursor-pointer content-center text-sm font-semibold">
          All observed metadata
        </summary>
        <div class="mt-3 mb-2 min-w-0">
          <CodeBlock
            code={JSON.stringify(example.plan.rawMetadata, null, 2)}
            lang="json"
            title="Expanded metadata · includes project extensions"
          />
        </div>
      </details>
    )}
  </aside>
</section>
