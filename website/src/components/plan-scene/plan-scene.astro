---
import Badge from 'jg-personal-astro-ui/badge';
import Tabs from 'jg-personal-astro-ui/tabs';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import CodeDiff from 'jg-personal-astro-ui/code-diff';
import { loadLifecycle } from '../../content/examples.ts';
import CriterionProgress from '../criterion-progress/criterion-progress.astro';
import DocumentFlow from '../document-flow/document-flow.astro';

const lifecycle = await loadLifecycle();
---

<section id="lifecycle" class="plan-scene scroll-mt-24" aria-label="A plan through its lifecycle">
  <Tabs
    id="plan-lifecycle"
    label="Plan lifecycle"
    tabs={lifecycle.stages.map(({ id, label }) => ({ id, label }))}
  >
    {lifecycle.stages.map((stage) => (
      <div slot={stage.id} class="pt-6">
        <header class="mb-6 max-w-3xl">
          <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{stage.title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{stage.description}</p>
        </header>
        {stage.id === 'revise' ? (
          <CodeDiff
            before={{ code: lifecycle.before, title: 'Before · revision 1' }}
            after={{ code: lifecycle.after, title: 'After · revision 2' }}
            lang="text"
          />
        ) : (
          <DocumentFlow
            source={stage.source}
            filename="plan.md"
            call={
              stage.id === 'create'
                ? 'createPlan(options)'
                : stage.id === 'inspect'
                  ? 'inspectPlan(directory)'
                  : stage.id === 'update'
                    ? 'updatePlan(directory, patch)'
                    : 'writePlanDocument(directory, input)'
            }
            result={stage.result}
          />
        )}
        {stage.id === 'update' && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Criterion progress">
            {lifecycle.progress.map((criterion) => (
              <li class="flex min-h-10 items-center gap-2 rounded-lg border border-border bg-surface px-3">
                <span class="font-mono text-xs font-semibold">{criterion.id}</span>
                <CriterionProgress progress={criterion.progress} />
              </li>
            ))}
          </ul>
        )}
        {stage.id === 'revise' && (
          <div class="mt-6 grid min-w-0 gap-5 md:grid-cols-2">
            <div class="rounded-xl border border-danger/35 bg-surface p-5 md:col-span-2">
              <p class="font-mono text-xs text-muted">
                check · plan.md line {lifecycle.finding.line}
              </p>
              <p class="mt-3 flex flex-wrap items-center gap-2">
                <Badge variant="danger" dot>
                  {lifecycle.finding.code}
                </Badge>
                <span class="font-mono text-sm font-semibold">{lifecycle.finding.criterion}</span>
              </p>
              <p class="mt-3 text-sm text-muted">
                No milestone delivers {lifecycle.finding.criterion} until the next breakdown.
              </p>
            </div>
            <div class="rounded-xl border border-border bg-surface p-5">
              <p class="font-mono text-xs text-muted">Milestones · exact original bytes</p>
              <ul class="mt-4 space-y-4">
                {lifecycle.retained.map((entry) => (
                  <li>
                    <p class="flex flex-wrap justify-between gap-2 font-semibold">
                      {entry.title}
                      <span class="font-mono text-xs text-accent">{entry.status}</span>
                    </p>
                    <p class="mt-1 font-mono text-xs wrap-anywhere text-muted">{entry.id}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-xl border border-accent/35 bg-surface p-5">
              <p class="font-mono text-xs text-accent">Skills binding · stale after revision</p>
              <p class="mt-4 text-sm leading-7 text-muted">
                Done markers stay; skills wait for a fresh breakdown before executing.
              </p>
            </div>
          </div>
        )}
        {stage.id === 'revise' && (
          <details class="mt-5 rounded-lg border border-border px-4 py-2">
            <summary class="min-h-10 cursor-pointer content-center text-sm font-semibold">
              Actual revision observation
            </summary>
            <div class="my-4 min-w-0">
              <CodeBlock
                copyDisplay="icon"
                code={JSON.stringify(stage.result, null, 2)}
                lang="json"
                title="JSON · selected result fields"
              />
              <CodeBlock
                copyDisplay="icon"
                code={stage.source}
                lang="markdown"
                title="Complete revised plan.md"
              />
            </div>
          </details>
        )}
        <details class="mt-5 rounded-lg border border-border px-4 py-2">
          <summary class="min-h-10 cursor-pointer content-center text-sm font-semibold">
            Public API call · excerpt
          </summary>
          <div class="my-4 min-w-0">
            <CodeBlock
              copyDisplay="icon"
              code={stage.code}
              lang="typescript"
              title="Selected API call · inputs from this example"
            />
          </div>
        </details>
      </div>
    ))}
  </Tabs>
  <p class="mt-5 text-xs leading-6 text-muted">
    Actual reference-library output · the skills binding is example consumer policy.
  </p>
</section>
