---
import Tabs from 'jg-personal-astro-ui/tabs';
import { loadExample } from '../../content/examples.ts';
import DocumentFlow from '../document-flow/document-flow.astro';

const example = await loadExample('small');
const withMilestones = await loadExample('milestones');
---

<div class="plan-scene" data-static-tabs>
  <Tabs
    id="home-documents"
    label="Markdown to JSON"
    tabs={[
      { id: 'plan', label: 'plan.md' },
      { id: 'milestones', label: 'milestones.md · optional' },
    ]}
  >
    <div slot="plan" class="pt-6">
      <DocumentFlow
        source={example.documents.plan!}
        filename="plan.md"
        call="parsePlan(source)"
        result={{ metadata: example.plan!.metadata, body: example.plan!.body }}
      />
    </div>
    <div slot="milestones" class="pt-6">
      <DocumentFlow
        source={withMilestones.documents.milestones!}
        filename="milestones.md"
        call="parseMilestones(source)"
        result={{
          milestones: withMilestones.milestones!.milestones.map(
            ({ ordinal, title, status, id }) => ({ ordinal, title, status, id }),
          ),
        }}
      />
    </div>
  </Tabs>
  <p class="mt-4 text-sm text-muted">
    Actual output from the reference library. The full result also includes source locations and
    diagnostics.
  </p>
</div>
