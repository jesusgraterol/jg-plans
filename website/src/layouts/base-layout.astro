---
import BrandLogo from 'jg-personal-astro-ui/brand-logo';
import DocumentHead from 'jg-personal-astro-ui/document-head';
import JGMark from 'jg-personal-astro-ui/jg-mark';
import favicon from 'jg-personal-astro-ui/jg-favicon.svg?url';
import SiteFooter from 'jg-personal-astro-ui/site-footer';
import SiteHeader from 'jg-personal-astro-ui/site-header';
import SkipLink from 'jg-personal-astro-ui/skip-link';
import ThemeControl from 'jg-personal-astro-ui/theme-control';
import ThemeInitScript from 'jg-personal-astro-ui/theme-init-script';
import { buildStructuredData } from 'jg-site';

import { PAGES, SITE, type IPage } from '../site.config.ts';
import '../styles/global.css';

interface Props {
  page: IPage;
  noIndex?: boolean;
}
const { page, noIndex = false } = Astro.props;
const navigation = [
  ...PAGES.flatMap((entry) =>
    'navigationLabel' in entry
      ? [{ href: entry.path, label: entry.navigationLabel, match: 'prefix' as const }]
      : [],
  ),
  { href: SITE.repository, label: 'GitHub', external: true },
];
const canonicalUrl = new URL(page.path, SITE.url).href;
const structuredData = noIndex
  ? undefined
  : buildStructuredData({
      canonicalUrl,
      title: page.title,
      description: page.description,
      type: page.path === '/' ? 'website' : 'webpage',
      site: {
        name: SITE.name,
        url: SITE.url,
        language: 'en',
        author: { name: 'Jesus Graterol', url: 'https://jesusgraterol.dev' },
      },
    });
---

<!doctype html>
<html lang="en">
  <head>
    <DocumentHead
      title={page.title}
      description={page.description}
      siteName={SITE.name}
      canonicalUrl={noIndex ? undefined : canonicalUrl}
      noIndex={noIndex}
      alternate={
        noIndex
          ? undefined
          : {
              href: new URL(`/raw/${page.source ?? 'index.md'}`, SITE.url).href,
              type: 'text/markdown',
              title: 'Read as Markdown',
            }
      }
      llmsTextUrl={new URL('/llms.txt', SITE.url).href}
      openGraphImage={{
        url: new URL(SITE.image, SITE.url).href,
        width: 1200,
        height: 630,
        type: 'image/png',
        alt: SITE.imageAlt,
      }}
      icons={[{ href: favicon, rel: 'icon', type: 'image/svg+xml' }]}
      structuredData={structuredData}
    />
    <ThemeInitScript storageKey={SITE.themeKey} />
    {/*
     * Repeats the shared stylesheet's page-transition opt-in inline. Chromium can resolve an
     * incoming page's opt-in from the styles active when its body started, so when the bundled
     * stylesheet arrives later it skips the transition and reports an unhandled InvalidStateError.
     */}
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition {
          navigation: none;
        }
      }
    </style>
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={page.path} homeLabel="jg-plans home" items={navigation}>
      <BrandLogo slot="brand" name="jg-plans">
        <JGMark slot="mark" class="size-8 shrink-0" />
      </BrandLogo>
      <ThemeControl slot="actions" storageKey={SITE.themeKey} />
      <ThemeControl slot="mobile-actions" storageKey={SITE.themeKey} />
    </SiteHeader>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter
      columns={[
        {
          title: 'Build on the protocol',
          links: PAGES.filter(
            (entry) => entry.path.startsWith('/docs/') || entry.path === '/examples/',
          ).map((entry) => ({ href: entry.path, label: entry.label })),
        },
        {
          title: 'Read the protocol',
          links: PAGES.filter((entry) => entry.path.startsWith('/protocol/')).map((entry) => ({
            href: entry.path,
            label: entry.label,
          })),
        },
        {
          title: 'Build with us',
          links: [
            { href: SITE.repository, label: 'Source on GitHub', external: true },
            { href: `${SITE.repository}/issues`, label: 'Feedback & ideas', external: true },
            {
              href: `${SITE.repository}/blob/main/LICENSE`,
              label: 'MIT license',
              external: true,
            },
          ],
        },
      ]}
      notes={['Made by Jesus Graterol. Small by design. Open by default.']}
    >
      <BrandLogo slot="brand" name="jg-plans">
        <JGMark slot="mark" class="size-8 shrink-0" />
      </BrandLogo>
      <p slot="about">Markdown plans, structured data, and tools you can build on.</p>
    </SiteFooter>
    <script>
      // Plain Markdown has no transition opt-in; skip its outgoing HTML snapshot explicitly.
      window.addEventListener('pageswap', (event) => {
        const destination = event.activation?.entry.url;
        if (destination && new URL(destination).pathname.startsWith('/raw/')) {
          event.viewTransition?.skipTransition();
        }
      });
    </script>
  </body>
</html>
