---
import Prose from 'jg-personal-astro-ui/prose';
import DocumentationShell from 'jg-personal-astro-ui/documentation-shell';
import DocumentationOutline from 'jg-personal-astro-ui/documentation-outline';
import PageNavigation from 'jg-personal-astro-ui/page-navigation';
import { readAvailability } from '../availability.ts';
import BaseLayout from './base-layout.astro';
import { PAGES, type IPage } from '../site.config.ts';

interface Props {
  page: IPage;
  headings?: readonly { depth: number; slug: string; text: string }[];
}
const { page, headings = [] } = Astro.props;
const availability = readAvailability(import.meta.env.JG_PLANS_AVAILABILITY);
const next = PAGES[(PAGES.findIndex((entry) => entry.path === page.path) + 1) % PAGES.length]!;
---

<BaseLayout page={page}>
  <DocumentationShell
    currentPath={page.path}
    navigation={[
      {
        label: 'Explore jg-plans',
        items: PAGES.slice(1).map((entry) => ({ href: entry.path, label: entry.label })),
      },
    ]}
  >
    <DocumentationOutline
      slot="outline"
      items={headings
        .filter((heading) => heading.depth === 2)
        .map((heading) => ({ href: `#${heading.slug}`, label: heading.text }))}
    />
    <article class="min-w-0" aria-labelledby="document-title">
      <header class="mb-8 border-b border-border pb-8 sm:mb-10 sm:pb-10">
        <p class="eyebrow mb-4 text-accent">
          {page.path.startsWith('/protocol/') ? 'The shared format' : 'Build with jg-plans'}
        </p>
        <h1 id="document-title" class="jg-document-title">
          {page.label}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{page.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted">
          <span class="font-mono">Protocol 0.1 · provisional</span>
          {page.path.startsWith('/docs/') &&
            (availability.state === 'published' ? (
              <a
                href={`https://www.npmjs.com/package/jg-plans/v/${availability.version}`}
                class="inline-flex min-h-8 items-center font-mono underline underline-offset-4"
              >
                npm {availability.version}
              </a>
            ) : (
              <span>
                Package {availability.version} ·{' '}
                {availability.state === 'unknown'
                  ? 'availability unverified'
                  : 'development preview'}
              </span>
            ))}
          {page.source && (
            <a
              href={`/raw/${page.source}`}
              class="inline-flex min-h-8 items-center underline underline-offset-4"
            >
              Read as Markdown
            </a>
          )}
          <a
            href="#reference"
            class="inline-flex min-h-8 items-center font-semibold text-accent underline underline-offset-4"
          >
            Jump to reference ↓
          </a>
        </div>
      </header>
      <div class="min-w-0">
        <slot name="overview" />
      </div>
      <section
        id="reference"
        class="mt-12 min-w-0 border-t border-border pt-8 sm:mt-16 sm:pt-10"
        aria-label="Complete reference"
      >
        <p class="eyebrow mb-6 text-muted">Complete reference</p>
        <Prose titleVariant="document" class="wrap-anywhere">
          <slot />
        </Prose>
      </section>
      <div class="mt-12 border-t border-border pt-6">
        <p class="mb-4 text-xs text-muted">Continue exploring</p>
        <PageNavigation
          label="Continue reading"
          next={{ href: next.path, label: next.label, description: next.description }}
        />
      </div>
    </article>
  </DocumentationShell>
</BaseLayout>
