---
import Button from 'jg-personal-astro-ui/button';
import Card from 'jg-personal-astro-ui/card';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import InstallCommand from 'jg-personal-astro-ui/install-command';
import { readAvailability } from '../availability.ts';
import PlanScene from '../components/plan-scene/plan-scene.astro';
import ProtocolMap from '../components/protocol-map/protocol-map.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { PAGES } from '../site.config.ts';
import { loadExample } from '../content/examples.ts';

const dashboard = await loadExample('milestones');
const availability = readAvailability(import.meta.env.JG_PLANS_AVAILABILITY);
const integration = `import { inspectPlan, updatePlan } from 'jg-plans';

const current = await inspectPlan('./coding-agent-planning/example');
if (current.plan.state === 'readable') {
  await updatePlan(current.directory, {
    document: 'plan',
    expectedSha256: current.plan.sha256,
    set: { status: 'in progress' },
  });
}`;
---

<BaseLayout page={PAGES[0]}>
  <section class="jg-container pt-12 pb-12 sm:pt-20 sm:pb-16" aria-labelledby="hero-title">
    <header class="mx-auto max-w-4xl text-center">
      <p class="eyebrow mb-5 text-accent">Shared documents + deterministic tools</p>
      <h1 id="hero-title" class="hero-title text-balance">
        Plain Markdown.
        <br />
        <span class="text-accent">Precise tooling.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        Give people and coding agents shared planning documents. Create, inspect and edit them with
        a TypeScript library or local CLI. Your project chooses the workflow and approvals.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <Button href="/examples/#lifecycle">
          See a plan evolve <span aria-hidden="true">→</span>
        </Button>
        <Button href="#library-title" variant="outline">
          Start locally
        </Button>
      </div>
      <p class="mt-5 font-mono text-xs text-muted">
        Markdown protocol · TypeScript library · CLI · MIT licensed
      </p>
    </header>
    <div class="mt-10 sm:mt-14">
      <PlanScene />
    </div>
  </section>

  <section class="border-y border-border bg-secondary/35" aria-labelledby="tools-title">
    <div class="jg-container grid gap-10 py-12 sm:py-16 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow mb-4">From a file to your product</p>
        <h2 id="tools-title" class="section-title">
          Build the tool
          <br />
          you have in mind.
        </h2>
        <p class="mt-5 max-w-lg text-lg text-muted">
          Read a plan, show its progress, or pass its context to an agent. jg-plans gives you the
          document layer. You decide how the application works.
        </p>
        <a
          href="/docs/integrations/"
          class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-accent underline-offset-4 hover:underline"
        >
          See the integration guide <span aria-hidden="true">→</span>
        </a>
      </div>
      <div
        class="grid min-w-0 gap-4 sm:grid-cols-2"
        aria-label="Illustrative tools built from planning data"
      >
        <Card class="sm:col-span-2">
          <p class="mb-4 font-mono text-xs text-muted">YOUR DASHBOARD / EXAMPLE VIEW</p>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-xl font-semibold">Example gallery</h3>
            <span class="rounded-full bg-secondary px-3 py-1 font-mono text-xs">
              {dashboard.plan!.metadata.status}
            </span>
          </div>
          <ol class="mt-5 grid gap-3 text-sm">
            {dashboard.milestones!.milestones.map((milestone) => (
              <li class="flex items-center gap-3">
                <span class="text-accent" aria-hidden="true">
                  {milestone.status === 'done' ? '✓' : '○'}
                </span>
                <span>{milestone.title}</span>
                <span class="ml-auto font-mono text-xs text-muted">{milestone.status}</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 border-t border-border pt-3 text-xs text-muted">
            An example view of the actual parsed milestone data.
          </p>
        </Card>
        <div class="border-l-2 border-accent py-1 pl-4">
          <h3 class="font-semibold">Agent context</h3>
          <p class="mt-2 text-sm text-muted">
            Give an agent the selected plan and the work still ahead.
          </p>
        </div>
        <div class="border-l-2 border-accent py-1 pl-4">
          <h3 class="font-semibold">Custom automation</h3>
          <p class="mt-2 text-sm text-muted">
            Connect JSON observations to your own project rules.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="jg-container grid gap-8 py-14 sm:py-20 lg:grid-cols-2 lg:items-center lg:gap-16"
    aria-labelledby="library-title"
  >
    <div class="min-w-0">
      <p class="eyebrow mb-4">A public API. A local CLI.</p>
      <h2 id="library-title" class="section-title">
        Read it. Inspect it.
        <br />
        Edit it precisely.
      </h2>
      <p class="mt-5 max-w-lg text-lg text-muted">
        Parse strings or inspect one selected directory. Guard writes against the source you read,
        keep custom metadata and edit only explicit fields. Revisions and approvals stay with your
        project.
      </p>
      {availability.state === 'published' ? (
        <div class="mt-6">
          <Fragment set:html="<!--email_off-->" />
          <InstallCommand
            copyDisplay="icon"
            id="install-command"
            command={`npm install jg-plans@${availability.version}`}
            context="install command"
            title={`Verified package · ${availability.version}`}
          />
          <Fragment set:html="<!--/email_off-->" />
          <p class="mt-3 text-xs text-muted">Node.js 24.15.0+ · Protocol 0.2 is provisional.</p>
        </div>
      ) : (
        <p class="mt-6 border-l-2 border-accent pl-4 text-sm text-muted">
          The protocol works on its own.{' '}
          <a href="/docs/" class="font-semibold underline underline-offset-4">
            Use a development checkout
          </a>{' '}
          while matching package availability is unverified.
        </p>
      )}
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
        <a href="/docs/api/" class="min-h-8 content-center underline underline-offset-4">
          Library API →
        </a>
        <a href="/docs/cli/" class="min-h-8 content-center underline underline-offset-4">
          CLI reference →
        </a>
      </div>
    </div>
    <div class="min-w-0">
      <CodeBlock
        copyDisplay="icon"
        code={integration}
        lang="typescript"
        title="your-application.ts"
      />
    </div>
  </section>

  <ProtocolMap />

  <section class="jg-container py-14 sm:py-20" aria-labelledby="freedom-title">
    <div class="mb-8 max-w-2xl">
      <p class="eyebrow mb-4">As much structure as the work needs</p>
      <h2 id="freedom-title" class="section-title">
        Start small. Stay in control.
      </h2>
    </div>
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="mb-4 font-mono text-sm text-accent">plan.md</p>
        <h3 class="text-xl font-semibold">One file is enough.</h3>
        <p class="mt-3 text-muted">
          Identity, dates, revision, and status above an ordinary Markdown body. No fixed list of
          headings.
        </p>
      </div>
      <div>
        <p class="mb-4 font-mono text-sm text-accent">+ milestones.md</p>
        <h3 class="text-xl font-semibold">Break it down when useful.</h3>
        <p class="mt-3 text-muted">
          Optional numbered milestones with explicit status markers. Add stable IDs when they help.
        </p>
      </div>
      <div>
        <p class="mb-4 font-mono text-sm text-accent">edit · move · delete</p>
        <h3 class="text-xl font-semibold">Your files remain yours.</h3>
        <p class="mt-3 text-muted">
          Keep custom fields. Remove old plans. Readers report what remains without rebuilding
          deleted history.
        </p>
      </div>
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/examples/">
        Explore the examples <span aria-hidden="true">→</span>
      </Button>
      <Button href="/protocol/" variant="outline">
        Understand the format
      </Button>
    </div>
  </section>
</BaseLayout>
