---
import { Content, getHeadings } from '../../../../../protocol/0.1/README.md';
import { loadSource } from '../../../content/index.ts';
import DocumentLayout from '../../../layouts/document-layout.astro';
import { PAGES } from '../../../site.config.ts';

await loadSource('specification');
const headings = getHeadings().filter((heading) => heading.depth === 2);
---

<DocumentLayout page={PAGES[2]}>
  <Fragment slot="navigation">
    <p class="eyebrow mb-4">Protocol 0.1</p>
    <a href={PAGES[1].path} class="mb-6 inline-block min-h-8 text-sm text-muted">
      ← All versions
    </a>
    <nav aria-label="On this page" class="grid gap-3 text-sm">
      {headings.map((heading) => (
        <a href={`#${heading.slug}`}>{heading.text}</a>
      ))}
    </nav>
  </Fragment>
  <Content />
</DocumentLayout>
